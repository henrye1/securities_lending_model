# Copy to .env to switch the backend from the local JSON dev store to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 8003/5176 defaults leave 8000-8002 / 5173-5175 free for the insurance, bank and finance siblings.
BACKEND_PORT=8003
CORS_ORIGINS=http://localhost:5176
DEV_STORE_PATH=./dev_store.json
